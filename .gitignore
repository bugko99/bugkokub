# ==========================================
# .gitignore - Document Converter Project
# ==========================================

# Environment variables
.env
.env.local
.env.*.local

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V{100,200}
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker volumes (local data)
mysql_data/
uploads/
converted/

# Coverage
coverage/
*.lcov

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm

# Uploaded files
backend/uploads/
backend/converted/
