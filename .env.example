# ==========================================
# DCMS (Damrongdham Center Management System)
# Environment Variables
# ==========================================

# --- Backend ---
BACKEND_PORT=5001
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=dcms_db

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5001/api
